rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images des produits - lecture publique
    match /product-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Autres fichiers - authentification requise
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
