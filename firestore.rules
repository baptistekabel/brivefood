rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // RÈGLES TEMPORAIRES POUR LE DÉVELOPPEMENT - À SÉCURISER EN PRODUCTION
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Règles pour les autres collections (à ajuster selon vos besoins)
    match /restaurants/{restaurantId} {
      allow read: if true; // Lecture publique des restaurants
      allow write: if request.auth != null; // Écriture pour les utilisateurs authentifiés
    }
    
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }
    
    match /menu/{menuId} {
      allow read: if true; // Menu public
      allow write: if request.auth != null;
    }
    
    match /categories/{categoryId} {
      allow read: if true; // Categories publiques
      allow write: if request.auth != null;
    }
    
    match /products/{productId} {
      allow read: if true; // Produits publics
      allow write: if request.auth != null;
    }
    
    // Pour les collections de développement/test, autoriser l'accès temporaire
    match /test/{document=**} {
      allow read, write: if true;
    }
  }
}