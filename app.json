{
  "expo": {
    "name": "Brive Food",
    "slug": "brivefood-app",
    "version": "1.0.28",
    "orientation": "default",
    "icon": "./assets/images/logoBrivefood.png",
    "scheme": "brivefoodapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.brivefood.app",
      "buildNumber": "53",
      "splash": {
        "image": "./assets/images/logoBrivefood.png",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/images/logoBrivefood.png",
          "backgroundColor": "#000000"
        }
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Cette application utilise l'appareil photo pour permettre aux utilisateurs de prendre des photos de leurs commandes et d'améliorer leur expérience.",
        "NSBluetoothAlwaysUsageDescription": "BriveFood utilise le Bluetooth pour se connecter à l'imprimante de tickets TM-M30II.",
        "NSBluetoothPeripheralUsageDescription": "BriveFood utilise le Bluetooth pour imprimer automatiquement les tickets de commande.",
        "NSLocalNetworkUsageDescription": "BriveFood utilise le réseau local pour se connecter à l'imprimante de tickets et imprimer automatiquement les commandes.",
        "NSBonjourServices": [
          "_ipp._tcp",
          "_ipps._tcp",
          "_pdl-datastream._tcp",
          "_printer._tcp"
        ],
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "versionCode": 53,
      "package": "com.brivefood.app",
      "icon": "./assets/images/logoBrivefood.png",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/logoBrivefood.png"
      },
      "splash": {
        "image": "./assets/images/logoBrivefood.png",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/images/logoBrivefood.png",
          "backgroundColor": "#000000"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "allowBackup": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoBrivefood.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/logoBrivefood.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "./plugins/withEpsonPrinter"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "assetBundlePatterns": [
      "assets/fonts/*"
    ],
    "extra": {
      "eas": {
        "projectId": "8fd04f98-e494-4ab6-a320-b353199c6e43"
      },
      "router": {}
    },
    "owner": "thecheatcode"
  }
}
